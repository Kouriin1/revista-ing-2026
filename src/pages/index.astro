---
import BaseLayout from '@layouts/BaseLayout.astro';
import { obtenerEdicionActiva } from '@lib/edicion';
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
// Portada ya compuesta a la proporción de la hoja por `npm run portada`
import portadaImg from '@assets/imagenes/portada-volumenII.jpg';
import usmLogo from '@assets/imagenes/usmlogo.png';
import PageFlipWrapper from '@components/islands/PageFlipWrapper.tsx';
import Placeholder from '@components/ui/Placeholder.astro';
import CabeceraArticulo from '@components/plantillas/CabeceraArticulo.astro';
import Referencias from '@components/ui/Referencias.astro';

const edicion = await obtenerEdicionActiva();
/* timeZone UTC a proposito: la fecha del JSON ("2026-06-01") se guarda como
   medianoche UTC, y al formatearla en la hora local del equipo que compila se
   iba al dia anterior (salia "mayo" en vez de "junio"). */
const fechaTexto = new Intl.DateTimeFormat('es', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(edicion.data.fechaPublicacion);

// Buscamos todos los articulos que pertenezcan a la edicion actual
const articulos = await getCollection('articulos', ({ data }) => data.edicion === edicion.data.numero);
articulos.sort((a, b) => a.data.orden - b.data.orden);

// El indice va como un unico bloque: el paginador del modo revista lo reparte
// llenando cada hoja hasta abajo y continuando en la siguiente si hace falta.
// Antes se troceaba aqui en grupos fijos y quedaban hojas medio vacias.

// Presentación / editorial: va en su propia hoja, justo detrás del índice
const editorial = await getEntry('institucional', 'editorial');
const Editorial = editorial ? (await render(editorial)).Content : null;
// Firma con el formato del original ("Junio, 2026."), pero tomando el dato de
// la edición para que no haya que tocarlo a mano el año que viene.
const mesFirma = new Intl.DateTimeFormat('es', { month: 'long', timeZone: 'UTC' }).format(edicion.data.fechaPublicacion);
const fechaFirma = `${mesFirma.charAt(0).toUpperCase()}${mesFirma.slice(1)}, ${edicion.data.fechaPublicacion.getUTCFullYear()}.`;
// Cintillo del pie de la contraportada: "Junio 2026"
const fechaPie = `${mesFirma.charAt(0).toUpperCase()}${mesFirma.slice(1)} ${edicion.data.fechaPublicacion.getUTCFullYear()}`;

const renders = await Promise.all(articulos.map(async (art) => {
  const { Content } = await render(art);
  const autoresResueltos = art.data.autores.length > 0 ? await getEntries(art.data.autores) : [];
  return { art, Content, autoresResueltos };
}));
---

<BaseLayout
  titulo={`${edicion.data.titulo} | Revista 3D`}
  descripcion={edicion.data.subtitulo}
  numeroEdicion={edicion.data.numero}
  ocultarHeader={true}
  ocultarFooter={true}
>
  <PageFlipWrapper client:only="react">
    
    <!-- 1. Pagina de Portada -->
    <div class="hoja-portada" style={`--portada-img: url('${portadaImg.src}')`}>
      {/* --- Elementos sobre la portada ocultos: ahora solo se muestra la imagen ---
      <div class="portada__logo-wrap">
        <Image src={usmLogo} alt="Universidad Santa María" class="portada__logo" />
      </div>
      <div class="portada__bottom">
        <h1 class="portada__titulo">{edicion.data.titulo}</h1>
        <p class="portada__sub">{edicion.data.subtitulo}</p>
        <span class="portada__edicion">Edición {edicion.data.numero} · {fechaTexto}</span>
      </div>
      --- fin elementos ocultos --- */}
    </div>

    <!-- 1.5 Pagina de Creditos / Autoridades (va despues de la portada, antes del indice) -->
    <div class="hoja-creditos">
      <div class="creditos-inner">
        <header class="creditos-header">
          <h1 class="creditos-titulo">Boletín Académico</h1>
          <p class="creditos-subtitulo">
            Centro de Investigaciones de la Facultad de Ingeniería y Arquitectura (CEFIA)
          </p>
          <div class="creditos-linea"></div>
        </header>

        <div class="creditos-grupo">
          <h2 class="creditos-etiqueta">Autoridades USM</h2>
          <ul class="creditos-lista">
            <li><span class="creditos-nombre">Dr. Ciro Nicolas Sosa Flores</span><span class="creditos-cargo">Rector</span></li>
            <li><span class="creditos-nombre">Dra. Virginia de Magalhaes</span><span class="creditos-cargo">Secretaria General</span></li>
            <li><span class="creditos-nombre">Dra. Antonina D'Amico</span><span class="creditos-cargo">Vicerrectora Académica</span></li>
            <li><span class="creditos-nombre">Lic. Giselle Petrica</span><span class="creditos-cargo">Vicerrectora Administrativa</span></li>
          </ul>
        </div>

        <div class="creditos-grupo">
          <h2 class="creditos-etiqueta">Facultad de Ingeniería y Arquitectura</h2>
          <ul class="creditos-lista">
            <li><span class="creditos-nombre">Arq. Susana Mileo de Sierra</span><span class="creditos-cargo">Decana</span></li>
            <li><span class="creditos-nombre">Arq. Ricardo Rodriguez</span><span class="creditos-cargo">Director</span></li>
          </ul>
        </div>

        <div class="creditos-grupo">
          <h2 class="creditos-etiqueta">Centro de Investigaciones CEFIA · Coordinadores</h2>
          <ul class="creditos-lista">
            <li><span class="creditos-nombre">Dr. Omar Alviárez</span></li>
            <li><span class="creditos-nombre">Ing. Acosta Heybart</span></li>
          </ul>
        </div>

        <div class="creditos-grupo">
          <h2 class="creditos-etiqueta">Diagramación</h2>
          <ul class="creditos-lista">
            <li><span class="creditos-nombre">Daniela Rodriguez</span></li>
            <li><span class="creditos-nombre">Roger Montero</span></li>
            <li><span class="creditos-nombre">Gabriel Franco</span></li>
            <li><span class="creditos-nombre">Ing. Ángel Cepeda</span></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 2. Paginas de Indice -->
    <div class="hoja-indice">
      <div class="indice-inner">
        <h2 class="indice-titulo">Índice</h2>
        <div class="indice-linea"></div>
        <ul class="indice-lista">
          {articulos.map((a, i) => (
            <li class="indice-item" data-articulo-idx={i}>
              <span class="indice-num">{(i + 1).toString().padStart(2, '0')}</span>
              <div class="indice-info">
                <span class="indice-categoria">{a.data.seccion.toUpperCase()}</span>
                <strong>{a.data.titulo}</strong>
              </div>
              <span class="indice-pag">—</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 2.5 Presentacion / Editorial (va detras del indice) -->
    {Editorial && (
      <div class="hoja-editorial">
        <div class="editorial-inner">
          <h2 class="editorial-titulo">{editorial!.data.titulo}</h2>
          <div class="editorial-linea"></div>
          <div class="editorial-cuerpo">
            <Editorial />
          </div>
          <div class="editorial-firma pf-no-partir">
            <span class="editorial-firma__nombre">{editorial!.data.autor}</span>
            {editorial!.data.cargo && (
              <span class="editorial-firma__cargo">{editorial!.data.cargo}</span>
            )}
            <span class="editorial-firma__inst">Universidad Santa María</span>
            <span class="editorial-firma__fecha">{fechaFirma}</span>
          </div>
        </div>
      </div>
    )}

    <!-- 3. Paginas de los Articulos -->
    {renders.map(({ art, Content, autoresResueltos }, i) => (
      <div class="hoja-articulo" data-articulo-idx={i}>
        {/* Franja decorativa de arriba con el numero y la categoria */}
        <div class="art-franja">
          <span class="art-franja__num">{String(i + 1).padStart(2, '0')}</span>
          <div class="art-franja__linea"></div>
          <span class="art-franja__seccion">{art.data.seccion.toUpperCase()}</span>
        </div>

        <CabeceraArticulo articulo={art} autoresResueltos={autoresResueltos} variante="centrada" />
        
        <div class="plantilla-a__cuerpo prosa dropcap">
          <Content />
        </div>

        {art.data.referencias && art.data.referencias.length > 0 && (
          <section class="referencias-seccion">
            <div class="refs-encabezado">
              <span class="refs-linea"></span>
              <span class="refs-titulo">Referencias</span>
              <span class="refs-linea"></span>
            </div>
            <Referencias items={art.data.referencias} />
          </section>
        )}
      </div>
    ))}

    <!-- 4. Pagina final de Contraportada -->
    <div class="hoja-contraportada">
      <div class="contraportada-content">
        <Image src={usmLogo} alt="Logo USM" class="contraportada__logo" />
      </div>
      <div class="contraportada-pie">
        <div class="contraportada-pie__linea"></div>
        <span class="contraportada-pie__titulo">Boletín Académico</span>
        <span class="contraportada-pie__fecha">{fechaPie}</span>
      </div>
    </div>

  </PageFlipWrapper>
</BaseLayout>

<style>
  /* Estilos de la portada */
  .hoja-portada {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Color de la propia portada: es lo que se ve mientras carga la imagen. */
    background-color: #12224d;
    /* La imagen ya viene compuesta con la proporción exacta de la hoja (la
       genera scripts/portada.mjs), así que `cover` la encaja sin recortar
       nada y sin dejar franjas. */
    background-image: var(--portada-img);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* Logo en la parte superior — pegado al tope */
  .portada__logo-wrap {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 3;
  }
  .portada__logo {
    width: 140px;
    height: auto;
    /* Sin fondo, sin borde — logo limpio */
    background: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    /* Sombra de texto suave para que se vea sobre cualquier fondo */
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.6));
  }
  /* Franja inferior con título */
  .portada__bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    background: linear-gradient(transparent, rgba(0, 10, 40, 0.95) 25%);
    padding: 60px 28px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .portada__titulo {
    font-family: 'Georgia', var(--font-serif), serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF !important;
    text-shadow: 0 2px 6px rgba(0,0,0,0.8);
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
    letter-spacing: 0.01em;
  }
  .portada__sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: #FFFFFF !important;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
    margin: 0;
    font-style: italic;
    letter-spacing: 0.03em;
  }
  .portada__edicion {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #FFFFFF !important;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
    margin-top: 4px;
  }

  /* Créditos / Autoridades */
  .hoja-creditos {
    padding: 0 5px;
    background: transparent;
  }
  .creditos-inner {
    max-width: 100%;
    text-align: left;
  }
  .creditos-header {
    text-align: center;
  }
  .creditos-titulo {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: #002147;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .creditos-subtitulo {
    font-family: var(--font-serif);
    font-size: 0.5rem;
    font-style: italic;
    color: #4A4A4A;
    margin: 4px auto 0;
    line-height: 1.3;
    max-width: 88%;
  }
  .creditos-linea {
    height: 2px;
    background: #C5A059;
    margin: 6px auto 10px;
    width: 55%;
  }
  /* Los cuatro grupos caben de sobra en una hoja, asi que se reparten con aire
     en lugar de apretarse arriba. */
  .creditos-grupo {
    margin-bottom: 14px;
  }
  .creditos-grupo:last-child {
    margin-bottom: 0;
  }
  .creditos-etiqueta {
    font-family: var(--font-sans);
    font-size: 0.42rem;
    letter-spacing: 0.1em;
    color: #C5A059;
    font-weight: 700;
    text-transform: uppercase;
    text-align: left;
    margin: 0 0 3px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .creditos-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .creditos-lista li {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-align: left;
  }
  .creditos-nombre {
    font-family: var(--font-serif);
    font-size: 0.54rem;
    font-weight: 700;
    color: #002147;
    line-height: 1.2;
    text-align: left;
  }
  .creditos-cargo {
    font-family: var(--font-sans);
    font-size: 0.42rem;
    font-style: italic;
    color: #4A4A4A;
    line-height: 1.15;
    text-align: left;
  }

  /* Presentación / Editorial */
  .hoja-editorial {
    padding: 0 5px;
    background: transparent;
  }
  .editorial-titulo {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: #002147;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .editorial-linea {
    height: 2px;
    background: #C5A059;
    margin: 3px 0 6px;
    width: 100%;
  }
  /* La presentacion es una sola pagina en el original, y el texto justo la
     llena: se compone algo mas apretada que los articulos para que quepa
     entera y la firma no acabe sola en la hoja siguiente. */
  /* Los !important son necesarios: revista.css fija line-height/margin de los
     parrafos del libro tambien con !important. */
  .editorial-cuerpo :global(p) {
    font-family: var(--font-serif);
    text-align: justify;
    hyphens: auto;
    line-height: 1.30 !important;
    margin: 0 0 0.24em !important;
  }
  /* El cuerpo no lleva estilos propios a proposito: hereda la tipografia de la
     hoja (revista.css). Asi se ve igual aunque el paginador tenga que repartir
     la presentacion en dos hojas y los parrafos salgan del envoltorio. */
  .editorial-firma {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    margin-top: 3px;
    padding-top: 3px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    line-height: 1.2;
  }
  .editorial-firma__nombre {
    font-family: var(--font-serif);
    font-weight: 700;
    color: #002147;
  }
  .editorial-firma__cargo {
    font-family: var(--font-serif);
    font-style: italic;
    color: #4A4A4A;
  }
  .editorial-firma__inst {
    font-family: var(--font-serif);
    font-weight: 700;
    color: #002147;
  }
  .editorial-firma__fecha {
    font-family: var(--font-serif);
    color: #4A4A4A;
  }

  /* Índice */
  .hoja-indice {
    padding: 0 5px; /* Reducido drásticamente para dar más ancho al texto */
    background: transparent; /* El fondo ya lo da la hoja base */
  }
  .indice-inner {
    max-width: 100%;
  }
  .indice-titulo {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: #002147;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .indice-linea {
    height: 2px;
    background: #C5A059;
    margin: 4px 0 6px;
    width: 100%;
  }
  .indice-lista {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .indice-item {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    padding-bottom: 4px;
  }
  .indice-num {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    font-weight: 700;
    color: #C5A059;
    line-height: 1;
    min-width: 20px;
  }
  .indice-info {
    display: flex;
    flex-direction: column;
    gap: 0px;
    flex: 1; /* Permite que tome todo el espacio disponible empujando el número de pág */
    min-width: 0; /* CRUCIAL: Permite que el flex item se encoja y el texto haga wrap */
    padding-right: 12px;
  }
  .indice-categoria {
    font-family: var(--font-sans);
    font-size: 0.4rem;
    letter-spacing: 0.08em;
    color: #C5A059;
    font-weight: 700;
    text-transform: uppercase;
  }
  .indice-info strong {
    font-family: var(--font-serif);
    font-size: 0.58rem;
    color: #002147 !important;
    line-height: 1.2;
    font-weight: 700;
    background: transparent !important; /* Quitar fondo amarillo heredado */
    padding: 0 !important;
    text-align: left;
  }
  .indice-info p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: #4A4A4A;
    line-height: 1.4;
  }
  .indice-pag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 800;
    color: #002147;
    white-space: nowrap; /* Evita que el "p. 69" se parta en dos líneas */
    min-width: 35px;
    text-align: right;
  }

  /* Artículos (Prosa ajustada) */
  .hoja-articulo {
    padding: 10px 0 16px;
  }

  /* ── Franja decorativa de artículo (igual al índice) ── */
  .art-franja {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .art-franja__num {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    color: #C5A059;
    line-height: 1;
    min-width: 20px;
  }
  .art-franja__linea {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, #C5A059, rgba(197, 160, 89, 0.12));
  }
  .art-franja__seccion {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    letter-spacing: 0.12em;
    color: #C5A059;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* ── Encabezado de referencias ── */
  .refs-encabezado {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
    margin-top: 8px;
  }
  .refs-linea {
    flex: 1;
    height: 1px;
    background: rgba(0, 33, 71, 0.12);
  }
  .refs-titulo {
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #8A8A8A;
    white-space: nowrap;
  }
  
  /* Contraportada */
  .hoja-contraportada {
    width: 100%;
    height: 100%;
    /* Antes 800px fijos: desbordaba la caja de contenido de la hoja (684px)
       y descentraba el logo. */
    min-height: 100%;
    background: var(--color-azul-oxford-oscuro);
    color: #FFFFFF !important;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
    display: flex;
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  /* Cintillo al pie: mismo titulo de la revista y la fecha de la edicion. */
  .contraportada-pie {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 34px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: #FFFFFF;
    text-shadow: none;
  }
  .contraportada-pie__linea {
    width: 90px;
    height: 1px;
    background: rgba(255, 255, 255, 0.55);
    margin-bottom: 7px;
  }
  .contraportada-pie__titulo {
    font-family: var(--font-sans);
    font-size: 0.5rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .contraportada-pie__fecha {
    font-family: var(--font-sans);
    font-size: 0.44rem;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.75);
  }
  .contraportada-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }
  .contraportada__logo {
    width: 140px;
    height: auto;
    margin-bottom: 40px;
    background: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }
</style>
